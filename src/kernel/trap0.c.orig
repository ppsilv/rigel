/*
 * trap0.c -- despachante de syscalls do kernel Rigel (TRAP #0)
 *
 * SUBSTITUI o trap0.c inteiro. Todas as constantes de sys/syscall.h
 * aparecem aqui. As que ainda nao tem implementacao devolvem -1.
 *
 * Familia de arquivos usada pelos apps: SYS_OPEN/READ/WRITE/CLOSE/IOCTL/LSEEK
 * (0x48..0x4E). A familia SYS_F* (4..0x1A) fica reservada, devolvendo -1.
 */
#include <stdint.h>
#include <sys/vfs.h>
#include <sys/ksyscall.h>
#include <sys/scheduler.h>   /* OS_TaskExit(), current_task */
#include "trap0.h"
#include <sys/syscall_pty.h>   /* SYS_OPENPTY, SYS_SPAWN_IO (novos) */
#include <sys/sys_pty.h>

/*
 * Depuracao do SYS_WRITE: imprime na tela do KERNEL (VGA, via kernel_puts)
 * os argumentos recebidos e o retorno do vfs_write.
 * Para ligar: descomente a linha "#define TRAP_DEBUG 1".
 */
/* #define TRAP_DEBUG 1 */
#ifdef TRAP_DEBUG
extern void kernel_puts(const char *s);
extern void kernel_puthex(uint32_t v);
#define DBG_S(s) kernel_puts(s)
#define DBG_H(v) kernel_puthex((uint32_t)(v))
#else
#define DBG_S(s) ((void)0)
#define DBG_H(v) ((void)0)
#endif

/* DIAGNOSTICO de spawn/exit/waitpid: escreve direto no VGA do kernel.
 * Depois de resolver, comente a linha abaixo. */
//#define TRAP_DIAG 1
#ifdef TRAP_DIAG
extern void kernel_puts(const char *s);
extern void kernel_puthex(uint32_t v);
#endif

extern int vfs_dup(int oldfd, int newfd);          /* vfs.c */
extern int sys_spawn_io(const char *path, char **argv, int fd_in, int fd_out, int fd_err);   /* spawn.c */
int trap0_handler(int num, long a1, long a2, long a3, long a4, long a5, long a6, long a7)
{
    (void)a6; (void)a7;

    switch (num) {

    /* ---- implementadas ---- */
    case SYS_EXIT:
#ifdef TRAP_DIAG
        kernel_puts("\n[kernel] SYS_EXIT pid=");
        kernel_puthex(current_task ? (uint32_t)current_task->id : 0);
        kernel_puts("\n");
#endif
        if (current_task) {                       /* fecha arquivos/diretorios que a task deixou abertos */
            sys_fs_task_exit((int)current_task->id);
            sys_dir_task_exit((int)current_task->id);
        }
        if (current_task)
            sys_net_task_exit((int)current_task->id);
        OS_TaskExit();            /* fecha os fds da task (vfs_task_exit) e nao volta */
        return 0;
    case SYS_GETPID:
        return current_task ? (int)current_task->id : -1;
    case SYS_OPEN:
        return vfs_open((const char *)a1, (int)a2);
    case SYS_READ:
        return vfs_read((int)a1, (void *)a2, (uint32_t)a3);
    case SYS_WRITE: {
        int r;
        DBG_S("\n[W fd="); DBG_H(a1);
        DBG_S(" buf=");     DBG_H(a2);
        DBG_S(" len=");     DBG_H(a3);
        DBG_S("]\n");
        r = vfs_write((int)a1, (void *)a2, (uint32_t)a3);
        DBG_S("[W ret=");   DBG_H(r);
        DBG_S("]\n");
        return r;
    }
    case SYS_CLOSE:
#ifdef TRAP_DIAG
        kernel_puts("\n[kernel] SYS_CLOSE fd="); kernel_puthex((uint32_t)a1); kernel_puts("\n");
#endif
        /* tabela de fds por task: fechar 0/1/2 so' solta a referencia desta task */
        return vfs_close((int)a1);
    case SYS_IOCTL:
        return vfs_ioctl((int)a1, (int)a2, (void *)a3);
    case SYS_LSEEK:
        return vfs_lseek((int)a1, (uint32_t)a2, (int)a3);
    case SYS_SPAWN:
        return sys_spawn((const char *)a1, (char **)a2);
    case SYS_SPAWN_IO:      /* path, argv, fd_in, fd_out, fd_err */
        return sys_spawn_io((const char *)a1, (char **)a2, (int)a3, (int)a4, (int)a5);
    case SYS_OPENPTY:       /* a1 = int fds[2]: [0]=master (telnetd), [1]=slave (shell) */
        return pty_open_fds((int *)a1);
    case SYS_WAITPID:
#ifdef TRAP_DIAG
        kernel_puts("\n[kernel] WAITPID pid="); kernel_puthex((uint32_t)a1); kernel_puts("\n");
#endif
        /* o tick preempta; o filho continua rodando */
        while (OS_TaskAlive((int)a1)){
            OS_SleepTicks(1);
        }
            
#ifdef TRAP_DIAG
        kernel_puts("\n[kernel] WAITPID terminou\n");
#endif
        return 0;
    case SYS_FOPENDIR: return sys_opendir((const char *)a1);
    case SYS_FREADDIR: return sys_readdir((long)a1, (rigel_dirent_t *)a2);
    case SYS_FCLOSEDIR: return sys_closedir((long)a1);
    case SYS_CHDIR:      return sys_chdir((const char *)a1);
    case SYS_GETCWD:     return sys_getcwd((char *)a1, (long)a2);
    /* ---- arquivos FAT (familia SYS_F*, sys_fsfile.c / sys_fsdir.c) ---- */
    case SYS_FOPEN:      return sys_fopen((const char *)a1, a2);
    case SYS_FCLOSE:     return sys_fclose(a1);
    case SYS_FREAD:      return sys_fread(a1, (void *)a2, (unsigned long)a3);
    case SYS_FWRITE:     return sys_fwrite(a1, (const void *)a2, (unsigned long)a3);
    case SYS_FSYNC:      return sys_fsync(a1);
    case SYS_FLSEEK:     return sys_flseek(a1, a2, a3);
    case SYS_FIOCTL:     return sys_fioctl(a1, a2, (void *)a3);
    case SYS_FTELL:      return sys_ftell(a1);
    case SYS_FSIZE:      return sys_fsize(a1);
    case SYS_FEOF:       return sys_feof(a1);
    case SYS_FUNLINK:    return sys_funlink((const char *)a1);
    case SYS_FRENAME:    return sys_frename((const char *)a1, (const char *)a2);
    case SYS_FSTAT:      return sys_fstat((const char *)a1, (rigel_dirent_t *)a2);
    case SYS_FMKDIR:     return sys_fmkdir((const char *)a1);
    case SYS_FMOUNT:     return sys_fmount((const char *)a1);
    case SYS_FUNMOUNT:   return sys_funmount((const char *)a1);
    case SYS_FFINDFIRST: return sys_findfirst((const char *)a1, (const char *)a2, (rigel_dirent_t *)a3);
    case SYS_FFINDNEXT:  return sys_findnext(a1, (rigel_dirent_t *)a2);
    case SYS_CHMOD:     return sys_chmod((const char *)a1, a2);
    //Keyboard
    case SYS_GETKBDKEY:  return sys_getkbdkey();
    case SYS_GETKEY:     return sys_getkey();
    case SYS_HASKEY:     return sys_haskey();
    //Time
    case SYS_GETUPTIME: return day_uptime;
    case SYS_READRTC:   return sys_readrtc();
    case SYS_WRITERTC:  return sys_writertc(a1);
    //Tasks
    case SYS_SLEEP:     return sys_sleep(a1);      /* a1 = milissegundos */
    case SYS_YIELD:     return sys_yield();
    case SYS_DUP:       return vfs_dup((int)a1, (int)a2);

    case SYS_SETRAMVECTOR:  sys_setramvector((long)a1, (long)a2);
                        return 0;
    //Screen                        
    case SYS_GOTOXY:    sys_gotoxy((long)a1, (long)a2);
                        return 0;
    case SYS_CLRSCR:    sys_clrscr();
                        return 0;
    case SYS_SETTEXTCOLOR: sys_settextcolor((long)a1, (long)a2);
                        return 0; 
    case SYS_GOHOME:    sys_gohome(); 
                        return 0;
    case SYS_SETCURVISIBILITY:
                        sys_setcurvisibility((const char)a1);
                        return 0;                        
    //Ethernet
    case SYS_SOCKET:     return sys_socket(a1, a2, a3);
    case SYS_BIND:       return sys_bind(a1, (const void *)a2, a3);
    case SYS_LISTEN:     return sys_listen(a1, a2);
    case SYS_ACCEPT:     return sys_accept(a1, (void *)a2, (long *)a3);
    case SYS_CONNECT:    return sys_connect(a1, (const void *)a2, a3);
    case SYS_SETSOCKOPT: return sys_setsockopt(a1, a2, a3, (const void *)a4, a5);
    //Graphical
    case SYS_DRAWVLINE:          return sys_drawvline(long a1, long a2, long a3, long a4);
    case SYS_DRAWHLINE:          return sys_drawhline(long a1, long a2, long a3, long a4);
    case SYS_DRAWLINE:           return sys_drawline(long a1, long a2, long a3, long a4, long a5);
    case SYS_DRAWCIRCLE:         return sys_drawcircle(long a1, long a2, long a3, long a4);
    case SYS_DRAWCIRCLEHELPER:   return sys_drawcirclehelper(long a1, long a2, long a3, long a4, long a5);
    case SYS_FILLCIRCLE:         return sys_fillcircle(long a1, long a2, long a3, long a4);
    case SYS_FILLCIRCLEHELPER:   return sys_fillcirclehelper(long a1, long a2, long a3, long a4, long a5, long a6);
    case SYS_DRAWROUNDRECT:      return sys_drawroundrect(long a1, long a2, long a3, long a4, long a5, long a6);
    case SYS_FILLROUNDRECT:      return sys_fillroundrect(long a1, long a2, long a3, long a4, long a5, long a6);
    case SYS_FILLRECT:           return sys_fillrect(short a1, short a2, short a3, short a4, short a5);
    case SYS_FILTRI:             return sys_filltri(float a1, float a2, float a3, float a4, float a5, float a6, char a7);

    /* ---- TODO: ainda sem implementacao ---- */
    case SYS_VGAPUTCHAR: return -1;
    case SYS_READTIME: return -1;   /* TODO */
    case SYS_WRITETIME: return -1;   /* TODO */
    case SYS_EEPROMREADBYTE: return -1;   /* TODO */
    case SYS_EEPROMWRITEBYTE: return -1;   /* TODO */
    case SYS_RINGBUFFERREAD: return -1;   /* TODO */
    case SYS_RINGBUFFERWRITE: return -1;   /* TODO */
    case SYS_DUARTACFG: return -1;   /* TODO */
    case SYS_DUARTAREAD: return -1;   /* TODO */
    case SYS_DUARTAWRITE: return -1;   /* TODO */
    case SYS_DUARTBCFG: return -1;   /* TODO */
    case SYS_DUARTBREAD: return -1;   /* TODO */
    case SYS_DUARTBWRITE: return -1;   /* TODO */
    case SYS_PPIACFG: return -1;   /* TODO */
    case SYS_PPIPORTAREAD: return -1;   /* TODO */
    case SYS_PPIPORTAWRITE: return -1;   /* TODO */
    case SYS_PPIBCFG: return -1;   /* TODO */
    case SYS_PPIPORTBREAD: return -1;   /* TODO */
    case SYS_PPIPORTBWRITE: return -1;   /* TODO */
    case SYS_PPICCFG: return -1;   /* TODO */
    case SYS_PPIPORTCREAD: return -1;   /* TODO */
    case SYS_PPIPORTCWRITE: return -1;   /* TODO */
    case SYS_SINC: return -1;   /* TODO */

    default:
        return -1;                /* numero de syscall desconhecido */
    }
}